# Copy to .env and fill in. .env is gitignored; never commit real values.
PARARIUS_EMAIL=your-pararius-email@example.com
PARARIUS_PASSWORD=your-pararius-password

# Only needed if the telegram section is present in config.yaml
# Token from @BotFather; chat id from `python telegram_setup.py`
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
