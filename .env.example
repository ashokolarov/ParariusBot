# Copy to .env and fill in. .env is gitignored; never commit real values.
PARARIUS_EMAIL=your-pararius-email@example.com
PARARIUS_PASSWORD=your-pararius-password

# Only needed if the twilio section is present in config.yaml
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
